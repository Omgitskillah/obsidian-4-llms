# Use a disposable existing vault for initial evaluation.
VAULT_PATH=/absolute/path/to/test-vault
OBSIDIAN_READ_ONLY=1
OBSIDIAN_PROTECT_USER_AUTHORED=1
# Optional: OBSIDIAN_MCP_LOG_DIR=/absolute/path/to/private/logs
# Optional semantic search: install Ollama and pull nomic-embed-text:v1.5.

# Optional read-only link audit policy; no model required.
# OBSIDIAN_LINK_POLICY=/absolute/path/to/link-policy.json

# Digest/parser/exclusion identity is persisted even when digest is empty or exclusions are [].
# Changing it later requires an explicit rebuild of a dedicated index.
